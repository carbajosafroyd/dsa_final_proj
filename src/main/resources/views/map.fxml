<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.dsa_final_proj.ui.controller.MapController"
            styleClass="dashboard-content">

    <center>
        <StackPane styleClass="stat-card">
            <!-- The Map Image -->
            <ImageView fx:id="mapImageView" preserveRatio="true" fitWidth="750" fitHeight="550">
                <image>
                    <Image url="@/images/map-v2.png"/>
                </image>
            </ImageView>
            <!-- The drawing canvas overlay -->
            <Canvas fx:id="mapCanvas" width="750" height="550" onMouseClicked="#handleCanvasClick"/>
        </StackPane>
    </center>

    <right>
        <VBox spacing="25" styleClass="control-panel" prefWidth="300" BorderPane.alignment="TOP_CENTER">
            <BorderPane.margin>
                <Insets left="30"/>
            </BorderPane.margin>
            
            <Label text="SPATIAL QUERY MODE" styleClass="metric-title"/>
            
            <VBox spacing="15">
                <RadioButton fx:id="rbNearest" text="Nearest Neighbor" selected="true" styleClass="modern-radio"/>
                
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <RadioButton fx:id="rbKNearest" text="K-Nearest" styleClass="modern-radio"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Spinner fx:id="kSpinner" prefWidth="70" styleClass="modern-spinner"/>
                </HBox>
                
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <RadioButton fx:id="rbRadius" text="Radius Search" styleClass="modern-radio"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="radiusField" text="150" prefWidth="70" styleClass="modern-input"/>
                </HBox>
            </VBox>
            
            <Separator styleClass="modern-separator"/>
            
            <Label text="SEARCH RESULTS" styleClass="metric-title"/>
            <ScrollPane fitToWidth="true" styleClass="results-scroll" VBox.vgrow="ALWAYS">
                <VBox fx:id="resultContainer" spacing="12"/>
            </ScrollPane>
            
        </VBox>
    </right>

</BorderPane>
