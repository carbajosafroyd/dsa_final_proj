<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.dsa_final_proj.ui.controller.FacilityFormController"
      styleClass="dashboard-content" spacing="20">

    <!-- Top Toolbar -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <Label text="Facility Management" styleClass="dash-subtitle"/>
        <Region HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="typeFilter" promptText="Filter by Type" styleClass="search-field"/>
        <Button text="+ Add Facility" onAction="#handleAdd" styleClass="action-btn"/>
        <Button text="Edit" onAction="#handleEdit" styleClass="action-btn"/>
        <Button text="Delete" onAction="#handleDelete" styleClass="danger-btn"/>
    </HBox>

    <!-- Data Table -->
    <TableView fx:id="facilityTable" VBox.vgrow="ALWAYS" styleClass="stat-card">
        <columns>
            <TableColumn fx:id="colName" text="Facility Name" prefWidth="250"/>
            <TableColumn fx:id="colType" text="Type" prefWidth="150"/>
            <TableColumn fx:id="colX" text="X Coord" prefWidth="100"/>
            <TableColumn fx:id="colY" text="Y Coord" prefWidth="100"/>
            <TableColumn fx:id="colDesc" text="Description" prefWidth="350"/>
        </columns>
        <placeholder>
            <Label text="No facilities found."/>
        </placeholder>
    </TableView>

</VBox>
