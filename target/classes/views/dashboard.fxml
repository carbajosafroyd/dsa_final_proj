<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.dsa_final_proj.ui.controller.DashboardController"
            styleClass="dashboard-root">

    <top>
        <VBox styleClass="dashboard-header">
            <Label text="Dashboard Overview" styleClass="header-title"/>
            <Label text="Real-time status of the KD-Tree spatial index" styleClass="header-subtitle"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="30" styleClass="dashboard-content">
            <!-- Metrics Row -->
            <HBox spacing="30">
                <!-- Metric 1 -->
                <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                    <Label text="TOTAL FACILITIES" styleClass="metric-title"/>
                    <Label fx:id="facilityCountLabel" text="0" styleClass="metric-value"/>
                    <Label text="Active nodes in index" styleClass="metric-caption"/>
                </VBox>

                <!-- Metric 2 -->
                <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                    <Label text="TREE BALANCE" styleClass="metric-title"/>
                    <Label text="Optimal" styleClass="metric-value-green"/>
                    <Label text="O(log n) search guaranteed" styleClass="metric-caption"/>
                </VBox>

                <!-- Metric 3 -->
                <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                    <Label text="SPATIAL ENGINE" styleClass="metric-title"/>
                    <Label text="Online" styleClass="metric-value-blue"/>
                    <Label text="Nearest-Neighbor ready" styleClass="metric-caption"/>
                </VBox>
            </HBox>

            <!-- Chart Row -->
            <VBox styleClass="chart-card" VBox.vgrow="ALWAYS">
                <Label text="FACILITY DISTRIBUTION" styleClass="metric-title"/>
                <PieChart fx:id="facilityTypesChart" legendSide="BOTTOM" VBox.vgrow="ALWAYS"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>
